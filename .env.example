# Get a key at https://developer.clashroyale.com (key is locked to your IP address)
CLASH_API_TOKEN=paste-your-token-here

# Your player tag from your in-game profile, including the #
MY_PLAYER_TAG=#XXXXXXXX

# Optional: defaults to a local SQLite file. Swap for Postgres in production, e.g.
# DATABASE_URL=postgresql://user:pass@localhost:5432/royalecoach
